# === Développement local ===
# Database - Modifier selon votre configuration PostgreSQL locale
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"
# En local, identique à DATABASE_URL (le pooler n'existe que sur Neon)
DIRECT_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# === Production (Vercel + Neon) ===
# Sur Neon : Dashboard > Connect > copier les DEUX chaînes.
# DATABASE_URL = connexion "Pooled" (hôte se terminant par -pooler), utilisée par l'app.
# DIRECT_URL   = connexion directe (sans -pooler), utilisée uniquement par `prisma db push`/`migrate`.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Server (ignoré sur Vercel, utilisé uniquement en serveur classique)
PORT=3010
HOST=0.0.0.0

# Environment
NODE_ENV=development

# Security - IMPORTANT: Changer ces secrets en production !
# Pour générer un secret fort: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-here-change-in-production"
JWT_EXPIRES_IN="24h"

# CORS - Origines autorisées en production (séparées par des virgules)
# Avec un déploiement Vercel mono-projet (front + API sur le même domaine),
# cette variable peut rester vide : les appels sont same-origin.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3010"

# Vercel Blob - Stockage des images uploadées (logo, produits, catégories)
# Dashboard Vercel > Storage > Create Database > Blob > copier le token.
# Laisser vide en local : l'upload retombe alors sur le disque (backend/uploads/).
BLOB_READ_WRITE_TOKEN=""
