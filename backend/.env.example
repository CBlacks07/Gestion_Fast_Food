# Database - Modifier selon votre configuration PostgreSQL locale
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Server
PORT=3000
HOST=0.0.0.0

# Environment
NODE_ENV=development

# Security - IMPORTANT: Changer ces secrets en production !
# Pour générer un secret fort: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-here-change-in-production"
JWT_EXPIRES_IN="24h"

# CORS - Origines autorisées en production (séparées par des virgules)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
