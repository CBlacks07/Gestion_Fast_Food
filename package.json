{
  "name": "gestion-fast-food",
  "version": "1.0.0",
  "description": "Application de gestion de fast-food avec architecture Local-First",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "db:migrate": "npm run migrate --workspace=backend",
    "db:seed": "npm run seed --workspace=backend",
    "db:generate": "npm run prisma:generate --workspace=backend"
  },
  "keywords": [
    "fastfood",
    "pos",
    "restaurant",
    "local-first"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
