# Configuration pour Electron Desktop App

# Port du serveur (ne pas changer sans modifier electron/main.js)
PORT=3002

# Mode production
NODE_ENV=production

# Base de données SQLite (sera dans le dossier utilisateur)
DATABASE_URL=file:./database.db

# JWT Secret (sera généré automatiquement au premier lancement)
JWT_SECRET=auto_generated

# Indicateur Electron
IS_ELECTRON=true

# URL du frontend (servi par le backend en mode Electron)
FRONTEND_URL=http://localhost:3002
